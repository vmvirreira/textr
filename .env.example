SECRET_KEY=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Supabase REST mode. This matches the Etherland Vercel project credentials.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Direct Postgres mode. Optional alternative to REST mode.
# Use the Supabase transaction pooler connection string for Vercel/serverless.
# Supabase Dashboard -> Connect -> Transaction pooler.
SUPABASE_DATABASE_URL=postgres://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
